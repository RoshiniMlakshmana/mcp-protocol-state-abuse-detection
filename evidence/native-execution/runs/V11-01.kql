let MCPSecurityAudit = datatable(['timestamp']:string, ['event.name']:string, ['principal.id_hash']:string, ['mcp.subscription.id']:string, ['mcp.subscription.instance_id']:string, ['mcp.authz.binding_id']:string, ['mcp.subscription.required_scope']:dynamic, ['mcp.authz.valid_until']:string, ['mcp.authz.grant_expiry']:string, ['security.hash.key_id']:string, ['mcp.subscription.notification_type']:string, ['mcp.authz.change.type']:string, ['mcp.authz.change.source']:string, ['mcp.authz.change.effective_at']:string, ['mcp.authz.change.timing_confidence']:string, ['mcp.authz.change.affected_scope']:string, ['mcp.authz.change.affected_binding_ids']:dynamic, ['mcp.authz.change.removed_scope']:dynamic) [
  "2026-10-01T17:00:00.000Z", "mcp.subscription.open", "h_ada04e757126cf52c5e99a2604bad837", "10001", "", "binding:v11-01", dynamic(null), "2026-10-01T20:00:00.000Z", "2026-10-01T20:00:00.000Z", "block3-test-key-v1", "", "", "", "", "", "", dynamic(null), dynamic(null),
  "2026-10-01T17:00:00.050Z", "mcp.subscription.acknowledged", "h_ada04e757126cf52c5e99a2604bad837", "10001", "", "", dynamic(null), "", "", "block3-test-key-v1", "", "", "", "", "", "", dynamic(null), dynamic(null),
  "2026-10-01T17:05:00.000Z", "mcp.subscription.authorization_change", "h_ada04e757126cf52c5e99a2604bad837", "", "", "", dynamic(null), "", "", "block3-test-key-v1", "", "revoked", "authorization_server_event", "2026-10-01T18:00:00.000Z", "authoritative", "binding", dynamic(["binding:v11-01"]), dynamic(null),
  "2026-10-01T17:10:00.000Z", "mcp.subscription.authorization_change", "h_ada04e757126cf52c5e99a2604bad837", "", "", "", dynamic(null), "", "", "block3-test-key-v1", "", "revoked", "authorization_server_event", "2026-10-01T17:07:00.000Z", "authoritative", "binding", dynamic(["binding:v11-01"]), dynamic(null),
  "2026-10-01T17:30:00.000Z", "mcp.subscription.notification", "h_ada04e757126cf52c5e99a2604bad837", "10001", "", "", dynamic(null), "", "", "block3-test-key-v1", "notifications/resources/updated", "", "", "", "", "", dynamic(null), dynamic(null),
  "2026-10-01T18:30:00.000Z", "mcp.subscription.notification", "h_ada04e757126cf52c5e99a2604bad837", "10001", "", "", dynamic(null), "", "", "block3-test-key-v1", "notifications/resources/updated", "", "", "", "", "", dynamic(null), dynamic(null)
];

// MCP Long-Lived Subscription Authorization Drift (Track 3) -- SCOPE-AWARE CORRECTION
// (example-driven regression pass -- see docs/validation-report.md "Track 3 remediation pass,
// part 3" for the ten independently-specified examples this query is checked against)
//
// HYPOTHETICAL TABLE: MCPSecurityAudit. Does not exist in Sentinel by default -- see
// detections/field-mapping.md.
//
// This is the AUTHORITATIVE implementation of Track 3. It implements
// telemetry/correlation.md's "Resolving affected bindings" reference algorithm: notifications
// are correlated to the AUTHORIZATION BINDING that actually backs them (mcp.authz.binding_id),
// not to "same principal" or "same wire subscription_id" -- both of which are, per current
// MCP/OAuth documentation, insufficient to establish revocation scope (see
// telemetry/schema.md SS5 "Scope-aware correction" for the full citation trail).
//
// THIS REVISION removes a second, subtler unsound shortcut a prior revision introduced to
// preserve legacy test expectations: a "sole-candidate fallback" that resolved an
// `affected_scope = unknown` change to a confirmed finding whenever exactly one binding was
// observed for that principal. THAT IS STILL AN INFERENCE, not evidence -- see fixture V13-03,
// which proves candidate count must never substitute for scope evidence, even when the count is
// exactly one. `affected_scope = unknown` (or a legacy event predating the field) now ALWAYS
// resolves to `InsufficientEvidence` when timing would otherwise indicate a violation,
// regardless of how many candidate bindings exist.
//
// THIS REVISION also replaces an "ever observed anywhere in the queried window" approximation
// for `affected_scope = all_principal_bindings` with a PRECISE effective-time interval check:
// a binding only counts as one of "all bindings this principal held" if it was already open
// (and not yet closed) AT THE MOMENT the change took effect -- see fixture V13-06, which proves
// a binding issued AFTER an account-wide revocation must not be swept up by it.
//
// THREE-OUTCOME REPORTING: every evaluated notification produces exactly one of
//   ConfirmedDrift | EvaluatedNoViolation | InsufficientEvidence
// reported as a single `Outcome` column, so reduced evaluability can never masquerade as clean
// detection. Precedence when a notification matches multiple signals: ConfirmedDrift wins over
// InsufficientEvidence wins over EvaluatedNoViolation. A legitimately closed stream is checked
// BEFORE scope ambiguity -- "the subscriber already stopped receiving notifications through the
// proper channel" is a definitive answer regardless of which binding a revocation targeted, so
// a suppressed notification is EvaluatedNoViolation, never flagged as scope-ambiguous.
//
// LEGACY-COMPATIBILITY FALLBACKS (telemetry/schema.md): an .open event lacking
// mcp.authz.binding_id is treated as an internal pseudo-binding scoped to
// (principal_hash, subscription_id); an .open/.notification/.close lacking
// mcp.subscription.instance_id is treated as instance_id = principal_hash + ":" + subscription_id
// (principal-scoped, NOT bare subscription_id -- two different principals legitimately reusing
// the identical wire id must not collide onto one instance); an .authorization_change lacking
// mcp.authz.change.affected_scope is treated as "unknown" (NEVER resolved via candidate count).
//
// TRACK 3 REMEDIATION PASS, PART 5 (this revision): native execution against a real Kusto
// engine (Microsoft's local "kustainer" emulator -- see docs/validation-report.md "Track 3
// remediation pass, part 5" and evidence/native-execution/) exposed a row-duplication defect
// this file's structure could not have surfaced from JS-model comparison alone: whenever a
// notification independently satisfied TWO OR MORE EvaluatedNoViolation-tier signals at once
// (e.g. a not-yet-crossed valid_until AND a scope-irrelevant downgrade on the SAME notification
// -- fixtures V11-07, V14-04, V14-05), the prior AllSignals-union design emitted one
// Informational-severity row PER contributing signal instead of one row for the notification.
// Outcome values were never wrong -- only the row count. Fixed by collapsing EvaluatedNoViolation
// ties to exactly one row per notification while retaining every contributing reason (see
// CollapsedNoViolation below); ConfirmedDrift and InsufficientEvidence ties are explicitly left
// unchanged -- collapsing those would hide a real distinct boundary or reason, which this fix
// does not touch.

let InvalidatingTypes = dynamic(["revoked", "expired", "scope_downgraded"]);

let Opens = MCPSecurityAudit
| where ['event.name'] == "mcp.subscription.open"
| project
    subscriptionId = tostring(['mcp.subscription.id']),
    instanceId = tostring(coalesce(['mcp.subscription.instance_id'], strcat(['principal.id_hash'], ":", ['mcp.subscription.id']))),
    principalHash = ['principal.id_hash'],
    bindingId = tostring(coalesce(['mcp.authz.binding_id'], strcat("legacy:", ['principal.id_hash'], ":", ['mcp.subscription.id']))),
    requiredScope = ['mcp.subscription.required_scope'],
    validUntil = todatetime(coalesce(['mcp.authz.valid_until'], ['mcp.authz.grant_expiry'])),
    openTime = todatetime(['timestamp']),
    keyId = ['security.hash.key_id'];

let Notifications = MCPSecurityAudit
| where ['event.name'] == "mcp.subscription.notification"
| project
    subscriptionId = tostring(['mcp.subscription.id']),
    instanceId = tostring(coalesce(['mcp.subscription.instance_id'], strcat(['principal.id_hash'], ":", ['mcp.subscription.id']))),
    principalHash = ['principal.id_hash'],
    notifTime = todatetime(['timestamp']),
    notificationType = ['mcp.subscription.notification_type'],
    ownBindingId = tostring(['mcp.authz.binding_id']),
    ownValidUntil = todatetime(['mcp.authz.valid_until']),
    keyId = ['security.hash.key_id'];

// Pre-aggregated to the earliest close per instance BEFORE any join -- joining raw close rows
// directly against notifications would multiply rows per notification when more than one close
// event exists, and an OR-based per-row filter over those duplicates can incorrectly let a
// notification through when only SOME of several close rows satisfy "close after notif_time"
// (the correct semantic is "was there ANY close at or before notif_time", which requires the
// earliest one specifically, not a per-row check).
let EarliestClose = MCPSecurityAudit
| where ['event.name'] == "mcp.subscription.close"
| extend instanceId = tostring(coalesce(['mcp.subscription.instance_id'], strcat(['principal.id_hash'], ":", ['mcp.subscription.id']))), principalHash = ['principal.id_hash'], closeTime = todatetime(['timestamp'])
| summarize earliestCloseTime = min(closeTime) by instanceId, principalHash;

let Changes = MCPSecurityAudit
| where ['event.name'] == "mcp.subscription.authorization_change"
| where ['mcp.authz.change.timing_confidence'] == "authoritative"
| where ['mcp.authz.change.type'] in (InvalidatingTypes)
| project
    principalHash = ['principal.id_hash'],
    changeType = ['mcp.authz.change.type'],
    changeSource = ['mcp.authz.change.source'],
    effectiveAt = todatetime(['mcp.authz.change.effective_at']),
    affectedScope = tostring(coalesce(['mcp.authz.change.affected_scope'], "unknown")),
    affectedBindingIds = coalesce(['mcp.authz.change.affected_binding_ids'], dynamic([])),
    removedScope = ['mcp.authz.change.removed_scope'],
    keyId = ['security.hash.key_id'];

// Conflicting-evidence pre-pass: a binding named invalidated by one authoritative change and
// ALSO named scope_upgraded by another cannot be resolved by picking a side.
let InvalidatedBindings = Changes
| where affectedScope == "binding" and changeType in (InvalidatingTypes)
| mv-expand bindingId = affectedBindingIds to typeof(string)
| distinct bindingId;
let UpgradedBindings = Changes
| where affectedScope == "binding" and changeType == "scope_upgraded"
| mv-expand bindingId = affectedBindingIds to typeof(string)
| distinct bindingId;
let ConflictedBindings = InvalidatedBindings | join kind=inner (UpgradedBindings) on bindingId | distinct bindingId;

let NotificationsResolved = Notifications
| join kind=leftouter (Opens | project instanceId, openBindingId = bindingId, openValidUntil = validUntil, requiredScope, openTime, openKeyId = keyId) on instanceId
| join kind=leftouter (EarliestClose) on instanceId, principalHash
| extend effectiveBindingId = coalesce(ownBindingId, openBindingId)
| extend effectiveValidUntil = iif(isnotempty(ownBindingId) and isnotnull(ownValidUntil), ownValidUntil, openValidUntil)
| extend epochMismatch = isnotempty(openKeyId) and isnotempty(keyId) and openKeyId != keyId
| extend isConflicted = effectiveBindingId in (ConflictedBindings);

// --- Signal 1: expiry leg. A suppressed (closed-before) crossing is EvaluatedNoViolation,
// never silently dropped. ---
let ExpirySignals = NotificationsResolved
| where isnotnull(effectiveValidUntil) and not(epochMismatch)
| extend crossed = notifTime > effectiveValidUntil,
         suppressed = isnotnull(earliestCloseTime) and earliestCloseTime <= notifTime
| extend Outcome = iif(crossed and not(suppressed), "ConfirmedDrift", "EvaluatedNoViolation"),
         Priority = iif(crossed and not(suppressed), 3, 1)
// Boundary/BoundaryTime are only meaningful for a CONFIRMED finding; blanked for
// EvaluatedNoViolation so this leg's tie-collapse (below) never has to arbitrarily pick one
// boundary among several independently-clean signals -- see the Reason tag instead.
| extend Boundary = iif(Outcome == "ConfirmedDrift", "valid_until", ""),
         BoundaryTime = iif(Outcome == "ConfirmedDrift", effectiveValidUntil, datetime(null)),
         Reason = case(Outcome == "ConfirmedDrift", "", crossed and suppressed, "expiry_suppressed_by_close", "expiry_not_yet_reached")
| distinct instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId, Outcome, Priority, Boundary, BoundaryTime, changeType1=tostring(""), changeSource1=tostring(""), Reason;

// --- Signal 2: epoch mismatch. ---
let EpochSignals = NotificationsResolved
| where epochMismatch
| project instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId,
    Outcome = "InsufficientEvidence", Priority = 2, Boundary = "", BoundaryTime = datetime(null),
    changeType1 = "", changeSource1 = "", Reason = "incompatible_hash_epoch";

// --- Signal 2b: incomplete timing evidence. A change record claiming timing_confidence=
// authoritative but omitting effective_at entirely is self-contradictory -- `todatetime()` on a
// missing field yields null, and null comparisons (`notifTime > effectiveAt`) would otherwise
// silently filter the row out of RevocationCandidates below, misreporting an unresolvable record
// as if it simply "did not apply". Detected explicitly here, BEFORE any timing comparison, so it
// surfaces as InsufficientEvidence instead (fixture V13-05). Mirrors the JS oracle: flags every
// notification for the affected principal, since no timing basis exists to rule any of them out.
let MalformedTimingChanges = MCPSecurityAudit
| where ['event.name'] == "mcp.subscription.authorization_change"
| where ['mcp.authz.change.timing_confidence'] == "authoritative"
| where ['mcp.authz.change.type'] in (InvalidatingTypes)
| where isempty(['mcp.authz.change.effective_at'])
| project principalHash = ['principal.id_hash'];
let MalformedTimingSignals = NotificationsResolved
| where not(epochMismatch)
| join kind=inner (MalformedTimingChanges) on principalHash
| project instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId,
    Outcome = "InsufficientEvidence", Priority = 2, Boundary = "", BoundaryTime = datetime(null),
    changeType1 = "", changeSource1 = "", Reason = "incomplete_timing_evidence";

// --- Signal 3: revocation / downgrade leg, expanded per Changes row. Timing and suppression
// are resolved BEFORE scope, so a legitimately closed stream or a not-yet-effective change never
// needs scope resolution at all. ---
let RevocationCandidates = NotificationsResolved
| where not(epochMismatch)
| join kind=inner (Changes) on principalHash
| extend crossed = notifTime > effectiveAt,
         suppressed = isnotnull(earliestCloseTime) and earliestCloseTime <= notifTime
| where crossed
// Precise effective-time interval check for all_principal_bindings: the binding must have been
// open (existed) AND not already closed by the time the change took effect -- NOT merely "ever
// observed anywhere in the window" (fixture V13-06).
| extend bindingExistedAtEffectiveAt = isnull(openTime) or openTime <= effectiveAt
| extend bindingAlreadyClosedByEffectiveAt = isnotnull(earliestCloseTime) and earliestCloseTime <= effectiveAt
| extend Applies = case(
    suppressed, "suppressed",
    isConflicted, "conflict",
    affectedScope == "all_principal_bindings", iif(bindingExistedAtEffectiveAt and not(bindingAlreadyClosedByEffectiveAt), "yes", "no"),
    affectedScope == "binding", case(isempty(effectiveBindingId), "ambiguous", set_has_element(affectedBindingIds, effectiveBindingId), "yes", "no"),
    "ambiguous")
| where Applies != "no" and Applies != "suppressed";
// Rows where Applies == "suppressed" or "no" contribute nothing further here -- "suppressed"
// still needs an EvaluatedNoViolation row (added below via ClearedByClose), and "no" is a
// definitive, evidence-based exclusion needing no further signal at all.

let ClearedByClose = NotificationsResolved
| where not(epochMismatch)
| join kind=inner (Changes) on principalHash
| extend crossed = notifTime > effectiveAt,
         suppressed = isnotnull(earliestCloseTime) and earliestCloseTime <= notifTime
| where crossed and suppressed
| project instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId,
    Outcome = "EvaluatedNoViolation", Priority = 1, Boundary = "", BoundaryTime = datetime(null),
    changeType1 = "", changeSource1 = "", Reason = "revocation_suppressed_by_close";

let RevocationSignals = RevocationCandidates
| where Applies == "yes"
| extend ScopeOk = case(
    changeType != "scope_downgraded", "yes",
    isempty(requiredScope) or isempty(removedScope), "missing",
    array_length(set_intersect(requiredScope, removedScope)) > 0, "yes",
    "irrelevant")
| extend Outcome = case(
    ScopeOk == "missing", "InsufficientEvidence",
    ScopeOk == "irrelevant", "EvaluatedNoViolation",
    "ConfirmedDrift")
| extend Priority = case(Outcome == "ConfirmedDrift", 3, Outcome == "InsufficientEvidence", 2, 1)
| extend Reason = case(ScopeOk == "missing", "missing_scope_evidence", ScopeOk == "irrelevant", "scope_downgrade_irrelevant", "")
// Boundary/BoundaryTime only carried for a CONFIRMED finding -- see ExpirySignals above for why.
| extend Boundary = iif(Outcome == "ConfirmedDrift", "effective_at", ""),
         BoundaryTime = iif(Outcome == "ConfirmedDrift", effectiveAt, datetime(null))
| project instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId,
    Outcome, Priority, Boundary, BoundaryTime,
    changeType1 = tostring(changeType), changeSource1 = tostring(changeSource), Reason;

let ConflictSignals = RevocationCandidates
| where Applies == "conflict"
| project instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId,
    Outcome = "InsufficientEvidence", Priority = 2, Boundary = "", BoundaryTime = datetime(null),
    changeType1 = "", changeSource1 = "", Reason = "conflicting_evidence";

let AmbiguousSignals = RevocationCandidates
| where Applies == "ambiguous"
| project instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId,
    Outcome = "InsufficientEvidence", Priority = 2, Boundary = "", BoundaryTime = datetime(null),
    changeType1 = "", changeSource1 = "", Reason = "ambiguous_scope";

// --- Baseline: every notification gets a floor row so summarize always has something to pick,
// defaulting to InsufficientEvidence("no_invalidity_evidence") if no leg above touched it. ---
let BaselineSignals = NotificationsResolved
| project instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId,
    Outcome = "InsufficientEvidence", Priority = 0, Boundary = "", BoundaryTime = datetime(null),
    changeType1 = "", changeSource1 = "", Reason = "no_invalidity_evidence";

let AllSignals = union ExpirySignals, EpochSignals, MalformedTimingSignals, RevocationSignals, ConflictSignals, AmbiguousSignals, ClearedByClose, BaselineSignals;

// One row per (instance, notification) AT THE WINNING PRIORITY: the highest-priority signal
// wins (ConfirmedDrift=3 > InsufficientEvidence=2 > EvaluatedNoViolation=1 > the Priority=0
// baseline). Grouped by instanceId/subscriptionId/principalHash/notifTime/notificationType --
// an unambiguous notification identity, never notifTime alone.
let WithMaxPriority = AllSignals
| summarize MaxPriority = max(Priority) by instanceId, subscriptionId, principalHash, notifTime, notificationType
| join kind=inner (AllSignals) on instanceId, subscriptionId, principalHash, notifTime, notificationType
| where Priority == MaxPriority;

// ConfirmedDrift and InsufficientEvidence ties are UNCHANGED: a notification confirmed on TWO
// independent boundaries at once (e.g. revocation AND expiry both crossed) still correctly
// keeps BOTH ConfirmedDrift rows, matching the JS oracle's per-leg union semantics. Never
// collapsed -- only EvaluatedNoViolation ties are (below).
let NonInformationalResults = WithMaxPriority
| where Outcome != "EvaluatedNoViolation"
| distinct instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId,
    Outcome, Boundary, BoundaryTime, changeType1, changeSource1, Reason;

// EvaluatedNoViolation ties collapse to exactly ONE row per notification, retaining every
// contributing reason (fixed here: a prior revision emitted one row PER independently-clean
// signal -- e.g. "valid_until not yet crossed" AND "scope-irrelevant downgrade" for the SAME
// notification produced two identical-outcome, Informational-severity rows, confirmed via
// native execution against V11-07/V14-04/V14-05 -- see docs/validation-report.md "Track 3
// remediation pass, part 5"). `any()` on Boundary/BoundaryTime/changeType1/changeSource1 is
// deterministic here because the true tie case blanks all four (see ExpirySignals/
// RevocationSignals above), so every row in a genuine tie already agrees on them; a single,
// non-tied EvaluatedNoViolation row's own values pass through unchanged.
let CollapsedNoViolation = WithMaxPriority
| where Outcome == "EvaluatedNoViolation"
| summarize Reasons = make_set(Reason), Boundary = any(Boundary), BoundaryTime = any(BoundaryTime),
    changeType1 = any(changeType1), changeSource1 = any(changeSource1)
    by instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId
| extend Outcome = "EvaluatedNoViolation", Reason = strcat_array(array_sort_asc(Reasons), "; ")
| project instanceId, subscriptionId, principalHash, notifTime, notificationType, effectiveBindingId,
    Outcome, Boundary, BoundaryTime, changeType1, changeSource1, Reason;

union NonInformationalResults, CollapsedNoViolation
| extend Severity = case(Outcome == "ConfirmedDrift", "High", Outcome == "InsufficientEvidence", "Medium", "Informational"),
         DetectionTrack = "Track3_SubscriptionAuthorizationDrift"
| project
    notifTime, Outcome, Severity, DetectionTrack, instanceId, subscriptionId, principalHash,
    notificationType, BindingId = effectiveBindingId, Boundary, BoundaryTime,
    AuthzChangeType = changeType1, AuthzChangeSource = changeSource1, Reason
| order by notifTime asc

// -----------------------------------------------------------------------------------------
// LOW-CONFIDENCE / INFORMATIONAL ONLY -- detected_at-only timing. Per the locked timing-
// confidence model, detected_at-only signals are NEVER promoted into the query above at all
// (they simply produce no RevocationSignals row, since `Changes` filters to
// timing_confidence == "authoritative"); this is reported as InsufficientEvidence
// ("no_invalidity_evidence") by BaselineSignals if nothing else applies, consistent with
// "detected_at-only timing is no longer promoted to a scored finding of any confidence" per
// telemetry/correlation.md. A separate, explicitly low-confidence hunting view over
// timing_confidence == "detected_only" events is intentionally NOT unioned into the primary
// query above; build it as its own saved search if your deployment wants that visibility.
// -----------------------------------------------------------------------------------------
